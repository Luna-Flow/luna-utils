    "b32_round_ties_even_neg_half",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0xbf000000U),
        @float.TiesToEven,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x0000000080000000UL,
  )
  emit_float_record(
    "b32_round_ties_away_neg_half",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0xbf000000U),
        @float.TiesToAway,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x00000000bf800000UL,
  )
  emit_float_record(
    "b32_round_toward_zero_neg_half",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0xbf000000U),
        @float.TowardZero,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x0000000080000000UL,
  )
  emit_float_record(
    "b32_round_toward_positive_neg_half",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0xbf000000U),
        @float.TowardPositive,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x0000000080000000UL,
  )
  emit_float_record(
    "b32_round_toward_negative_neg_half",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0xbf000000U),
        @float.TowardNegative,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x00000000bf800000UL,
  )
  emit_float_record(
    "b32_round_ties_even_three_quarters",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0x3f400000U),
        @float.TiesToEven,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x000000003f800000UL,
  )
  emit_float_record(
    "b32_round_ties_away_three_quarters",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0x3f400000U),
        @float.TiesToAway,
      ),
