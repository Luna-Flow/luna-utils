  emit_float_record(
    "b32_minimum_7f800001_80000001",
    @binary32.to_bits_canonical(
      @binary32.minimum(
        Float::reinterpret_from_uint(0x7f800001U),
        Float::reinterpret_from_uint(0x80000001U),
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x000000007fc00000UL,
  )
  emit_float_record(
    "b32_maximum_7f800001_80000001",
    @binary32.to_bits_canonical(
      @binary32.maximum(
        Float::reinterpret_from_uint(0x7f800001U),
        Float::reinterpret_from_uint(0x80000001U),
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x000000007fc00000UL,
  )
  emit_float_record(
    "b32_total_order_bits_7f800001_80800000",
    if @binary32.total_order_bits(0x7f800001U, 0x80800000U) {
      1UL
    } else {
      0UL
    },
    0x0000000000000000UL,
  )
  emit_float_record(
    "b32_total_order_7f800001_80800000",
    if @binary32.portable_total_order(
        Float::reinterpret_from_uint(0x7f800001U),
        Float::reinterpret_from_uint(0x80800000U),
