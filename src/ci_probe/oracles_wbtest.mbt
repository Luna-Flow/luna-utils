    "conv32_int_checked_present_toward_negative_bf800000",
    match
      @binary32.to_int_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TowardNegative,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int_checked_toward_negative_bf800000",
    match
      @binary32.to_int_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TowardNegative,
      ) {
      Some(value) => value.to_int64().reinterpret_as_uint64()
      None => 0UL
    },
    0xffffffffffffffffUL,
  )
  emit_float_record(
    "conv32_int_saturating_toward_negative_bf800000",
    @binary32.to_int_saturating_with(
      Float::reinterpret_from_uint(0xbf800000U),
      @float.TowardNegative,
    )
    .to_int64()
    .reinterpret_as_uint64(),
    0xffffffffffffffffUL,
  )
  emit_float_record(
    "conv32_int64_checked_present_ties_even_bf800000",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TiesToEven,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int64_checked_ties_even_bf800000",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TiesToEven,
      ) {
      Some(value) => value.reinterpret_as_uint64()
      None => 0UL
    },
    0xffffffffffffffffUL,
  )
  emit_float_record(
    "conv32_int64_saturating_ties_even_bf800000",
    @binary32.to_int64_saturating_with(
      Float::reinterpret_from_uint(0xbf800000U),
      @float.TiesToEven,
    ).reinterpret_as_uint64(),
    0xffffffffffffffffUL,
  )
  emit_float_record(
    "conv32_int64_checked_present_ties_away_bf800000",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TiesToAway,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int64_checked_ties_away_bf800000",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TiesToAway,
      ) {
      Some(value) => value.reinterpret_as_uint64()
      None => 0UL
    },
    0xffffffffffffffffUL,
  )
  emit_float_record(
    "conv32_int64_saturating_ties_away_bf800000",
    @binary32.to_int64_saturating_with(
      Float::reinterpret_from_uint(0xbf800000U),
      @float.TiesToAway,
    ).reinterpret_as_uint64(),
    0xffffffffffffffffUL,
  )
  emit_float_record(
    "conv32_int64_checked_present_toward_zero_bf800000",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0xbf800000U),
        @float.TowardZero,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
