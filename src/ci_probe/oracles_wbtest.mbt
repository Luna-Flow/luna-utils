    "conv32_int64_checked_toward_zero_cf10b8a",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TowardZero,
      ) {
      Some(value) => value.reinterpret_as_uint64()
      None => 0UL
    },
    0x0000000000000000UL,
  )
  emit_float_record(
    "conv32_int64_saturating_toward_zero_cf10b8a",
    @binary32.to_int64_saturating_with(
      Float::reinterpret_from_uint(0x0cf10b8aU),
      @float.TowardZero,
    ).reinterpret_as_uint64(),
    0x0000000000000000UL,
  )
  emit_float_record(
    "conv32_int64_checked_present_toward_positive_cf10b8a",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TowardPositive,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int64_checked_toward_positive_cf10b8a",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TowardPositive,
      ) {
      Some(value) => value.reinterpret_as_uint64()
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int64_saturating_toward_positive_cf10b8a",
    @binary32.to_int64_saturating_with(
      Float::reinterpret_from_uint(0x0cf10b8aU),
      @float.TowardPositive,
    ).reinterpret_as_uint64(),
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int64_checked_present_toward_negative_cf10b8a",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TowardNegative,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_int64_checked_toward_negative_cf10b8a",
    match
      @binary32.to_int64_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TowardNegative,
      ) {
      Some(value) => value.reinterpret_as_uint64()
      None => 0UL
    },
    0x0000000000000000UL,
  )
  emit_float_record(
    "conv32_int64_saturating_toward_negative_cf10b8a",
    @binary32.to_int64_saturating_with(
      Float::reinterpret_from_uint(0x0cf10b8aU),
      @float.TowardNegative,
    ).reinterpret_as_uint64(),
    0x0000000000000000UL,
  )
  emit_float_record(
    "conv32_uint_checked_present_ties_even_cf10b8a",
    match
      @binary32.to_uint_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TiesToEven,
      ) {
      Some(_) => 1UL
      None => 0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "conv32_uint_checked_ties_even_cf10b8a",
    match
      @binary32.to_uint_checked_with(
        Float::reinterpret_from_uint(0x0cf10b8aU),
        @float.TiesToEven,
      ) {
      Some(value) => value.to_uint64() & 0xffffffffUL
      None => 0UL
    },
    0x0000000000000000UL,
  )
  emit_float_record(
    "conv32_uint_saturating_ties_even_cf10b8a",
    @binary32.to_uint_saturating_with(
      Float::reinterpret_from_uint(0x0cf10b8aU),
