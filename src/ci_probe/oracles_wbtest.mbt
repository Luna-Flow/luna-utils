      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0x3f400000U),
        @float.TowardZero,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x0000000000000000UL,
  )
  emit_float_record(
    "b32_round_toward_positive_three_quarters",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0x3f400000U),
        @float.TowardPositive,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x000000003f800000UL,
  )
  emit_float_record(
    "b32_round_toward_negative_three_quarters",
    @binary32.to_bits_canonical(
      @binary32.round_to_integral(
        Float::reinterpret_from_uint(0x3f400000U),
        @float.TowardNegative,
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x0000000000000000UL,
  )
  emit_float_record(
