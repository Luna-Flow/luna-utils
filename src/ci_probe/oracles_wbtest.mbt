    "b32_total_order_bits_ff800001_7f800000",
    if @binary32.total_order_bits(0xff800001U, 0x7f800000U) {
      1UL
    } else {
      0UL
    },
    0x0000000000000001UL,
  )
  emit_float_record(
    "b32_total_order_ff800001_7f800000",
    if @binary32.portable_total_order(
        Float::reinterpret_from_uint(0xff800001U),
        Float::reinterpret_from_uint(0x7f800000U),
      ) {
      1UL
    } else {
      0UL
    },
    0x0000000000000000UL,
  )
  emit_float_record(
    "b32_minimum_ff800001_7f800000",
    @binary32.to_bits_canonical(
      @binary32.minimum(
        Float::reinterpret_from_uint(0xff800001U),
        Float::reinterpret_from_uint(0x7f800000U),
      ),
    ).to_uint64() &
    0xffffffffUL,
    0x000000007fc00000UL,
  )
  emit_float_record(
    "b32_maximum_ff800001_7f800000",
